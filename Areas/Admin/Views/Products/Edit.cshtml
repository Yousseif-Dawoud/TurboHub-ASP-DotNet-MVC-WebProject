@model TurboHub.ViewModels.Admin.ProductViewModel
@{
    ViewData["Title"] = "تعديل المنتج";
    var currentImage = Model.MainImagePath ?? Model.MainImageUrl;
    var extraImages = ViewBag.ExtraImages as List<TurboHub.Models.ProductImage>
        ?? new List<TurboHub.Models.ProductImage>();
}

<div class="page-header">
    <div>
        <h2>تعديل المنتج</h2>
        <p>@Model.Name</p>
    </div>
    <a href="/Admin/Products" class="btn-primary-admin">→ رجوع</a>
</div>

<form asp-action="Edit" asp-controller="Products" asp-area="Admin"
      asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="row g-4">

        <!-- Main info -->
        <div class="col-md-8">

            <div class="admin-form-card mb-4">
                <h6 class="fw-bold mb-4">المعلومات الأساسية</h6>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label">اسم المنتج *</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="SKU" class="form-label">رقم القطعة (SKU)</label>
                        <input asp-for="SKU" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Brand" class="form-label">الماركة التجارية</label>
                        <input asp-for="Brand" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label">القسم *</label>
                        <select asp-for="CategoryId" asp-items="ViewBag.Categories"
                                class="form-select">
                            <option value="">— اختر القسم —</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Price" class="form-label">السعر (جنيه) *</label>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DiscountPrice" class="form-label">سعر الخصم (اختياري)</label>
                        <input asp-for="DiscountPrice" class="form-control" type="number" step="0.01" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="StockQuantity" class="form-label">الكمية المتاحة *</label>
                        <input asp-for="StockQuantity" class="form-control" type="number" />
                        <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Condition" class="form-label">حالة القطعة</label>
                        <select asp-for="Condition" asp-items="ViewBag.Conditions"
                                class="form-select"></select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="WarrantyPeriod" class="form-label">فترة الضمان</label>
                        <input asp-for="WarrantyPeriod" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="LowStockThreshold" class="form-label">حد المخزون المنخفض</label>
                        <input asp-for="LowStockThreshold" class="form-control" type="number" />
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label">الوصف التفصيلي</label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    </div>
                </div>
            </div>

            <div class="admin-form-card mb-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h6 class="fw-bold mb-0">السيارات المتوافقة</h6>
                    <button type="button" class="btn-primary-admin" id="addCompatBtn"
                            onclick="addCompatRow()">
                        + إضافة سيارة
                    </button>
                </div>
                <div id="compatList">
                    <div class="text-muted small text-center py-3" id="noCompatMsg">
                        لم تُضف أي سيارة بعد — اضغط "إضافة سيارة"
                    </div>
                </div>
            </div>

        </div>

        <!-- Images and settings -->
        <div class="col-md-4">

            <div class="admin-form-card mb-4">
                <h6 class="fw-bold mb-4">الصورة الرئيسية</h6>

                <div id="mainImagePreview" class="image-preview-box">
                    @if (!string.IsNullOrEmpty(currentImage))
                    {
                        <img src="@currentImage" alt="@Model.Name" />
                    }
                    else
                    {
                        <span>لا توجد صورة</span>
                    }
                </div>

                <div class="mb-2">
                    <label class="form-label small">رفع صورة جديدة</label>
                    <input asp-for="MainImageFile" type="file"
                           class="form-control form-control-sm" accept="image/*"
                           onchange="previewMainImage(this)" />
                </div>
                <div class="text-center text-muted small my-2">— أو —</div>
                <div>
                    <label class="form-label small">رابط صورة (URL)</label>
                    <input asp-for="MainImageUrl" class="form-control form-control-sm"
                           oninput="previewMainUrl(this.value)" />
                </div>
            </div>

            <div class="admin-form-card mb-4">
                <h6 class="fw-bold mb-3">الصور الإضافية</h6>

                @if (extraImages.Any())
                {
                    <div class="existing-images mb-3">
                        @foreach (var img in extraImages)
                        {
                            <label class="existing-image-item">
                                <img src="@(img.ImagePath ?? img.ImageUrl)" alt="" />
                                <span class="existing-image-delete">
                                    <input type="checkbox" name="deleteImageIds" value="@img.Id" />
                                    حذف
                                </span>
                            </label>
                        }
                    </div>
                }

                <div class="mb-2">
                    <label class="form-label small">إضافة صور جديدة</label>
                    <input name="ExtraImageFiles" type="file"
                           class="form-control form-control-sm"
                           accept="image/*" multiple />
                </div>
                <div class="text-center text-muted small my-2">— أو —</div>
                <div id="extraUrlsList">
                    <div class="input-group mb-2">
                        <input type="text" name="ExtraImageUrls"
                               class="form-control form-control-sm"
                               placeholder="رابط صورة إضافية" />
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                onclick="addExtraUrlRow()">+</button>
                    </div>
                </div>
            </div>

            <div class="admin-form-card">
                <h6 class="fw-bold mb-3">الإعدادات</h6>
                <div class="form-check mb-2">
                    <input asp-for="IsActive" type="checkbox" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label small">
                        نشط (يظهر في المتجر)
                    </label>
                </div>
                <div class="form-check">
                    <input asp-for="IsFeatured" type="checkbox" class="form-check-input" />
                    <label asp-for="IsFeatured" class="form-check-label small">
                        مميز (يظهر في الرئيسية)
                    </label>
                </div>
            </div>

        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn-primary-admin">حفظ التعديلات</button>
        <a href="/Admin/Products" class="btn btn-outline-secondary">إلغاء</a>
    </div>
</form>

<script id="brandsData" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        ViewBag.CarBrands,
        new System.Text.Json.JsonSerializerOptions
        {
            PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
        }))
</script>

<script id="compatData" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Compatibilities.Select(c => new
        {
            brandId = c.CarBrandId,
            modelId = c.CarModelId,
            engineId = c.CarEngineId
        })))
</script>

@section Scripts {
    <script src="~/js/admin-products.js"></script>
    <script src="~/js/admin-products-edit.js"></script>
}