@using Microsoft.AspNetCore.Identity
@using TurboHub.Models
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - تيربو هب | لوحة التحكم</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- Sidebar -->
    <div class="sidebar">

        <!-- Brand -->
        <div class="sidebar-brand">
            <div class="brand-name">تيربو هب</div>
            <div class="brand-sub">لوحة التحكم الإدارية</div>
        </div>

        <!-- Menu -->
        <nav class="sidebar-menu">

            <div class="menu-label">الرئيسية</div>
            <a class="menu-item" href="/Admin/Dashboard">
                <span class="menu-icon">📊</span>
                <span>لوحة القيادة</span>
            </a>

            <div class="menu-label">المتجر</div>
            <a class="menu-item" href="/Admin/Products">
                <span class="menu-icon">🔧</span>
                <span>المنتجات</span>
            </a>
            <a class="menu-item" href="/Admin/Categories">
                <span class="menu-icon">📂</span>
                <span>الأقسام</span>
            </a>
            <a class="menu-item" href="/Admin/Cars">
                <span class="menu-icon">🚗</span>
                <span>السيارات</span>
            </a>

            <div class="menu-label">المبيعات</div>
            <a class="menu-item" href="/Admin/Orders">
                <span class="menu-icon">🛒</span>
                <span>الطلبات</span>
            </a>
            <a class="menu-item" href="/Admin/SpecialRequests">
                <span class="menu-icon">⭐</span>
                <span>الطلبات الخاصة</span>
            </a>

            <div class="menu-label">العملاء</div>
            <a class="menu-item" href="/Admin/Customers">
                <span class="menu-icon">👥</span>
                <span>العملاء</span>
            </a>

        </nav>

        <!-- Footer -->
        <div class="sidebar-footer">
            @{
                var user = await UserManager.GetUserAsync(User);
                var initials = user?.FullName?.Length > 0
                    ? user.FullName.Substring(0, 1)
                    : "A";
            }
            <div class="admin-info">
                <div class="admin-avatar">@initials</div>
                <div>
                    <div class="admin-name">@(user?.FullName ?? "Admin")</div>
                    <div class="admin-role">مسؤول النظام</div>
                </div>
            </div>
            <form action="/Account/Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-logout">
                    <span>🚪</span>
                    <span>تسجيل الخروج</span>
                </button>
            </form>
        </div>

    </div>

    <!-- Top Navbar -->
    <nav class="admin-navbar">
        <div class="d-flex align-items-center gap-3">
            <button class="navbar-icon-btn d-md-none" id="sidebarToggle">☰</button>
            <span class="navbar-page-title">@ViewData["Title"]</span>
        </div>
        <div class="navbar-right">
            <div class="navbar-search">
                <input type="text" placeholder="بحث..." />
                <span class="search-icon">🔍</span>
            </div>
            <a href="/" class="navbar-icon-btn" title="عرض المتجر">🏪</a>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="admin-content">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>