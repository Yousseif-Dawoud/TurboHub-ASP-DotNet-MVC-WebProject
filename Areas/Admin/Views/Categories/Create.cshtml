@model TurboHub.ViewModels.Admin.CategoryViewModel
@{
    ViewData["Title"] = "إضافة قسم جديد";
}

<div class="page-header">
    <div>
        <h2>إضافة قسم جديد</h2>
        <p>أضف قسماً جديداً لقطع الغيار</p>
    </div>
    <a href="/Admin/Categories" class="btn-primary-admin">
        → رجوع للقائمة
    </a>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="admin-form-card">
            <form asp-action="Create" asp-controller="Categories"
                  asp-area="Admin" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">اسم القسم *</label>
                    <input asp-for="Name" class="form-control"
                           placeholder="مثال: المحرك وملحقاته" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Icon" class="form-label">الأيقونة</label>
                    <select asp-for="Icon"
                            asp-items="ViewBag.IconList"
                            class="form-select">
                        <option value="">— اختر أيقونة —</option>
                    </select>
                    <span asp-validation-for="Icon" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ParentId" class="form-label">
                        القسم الرئيسي (اتركه فارغاً إذا كان قسماً رئيسياً)
                    </label>
                    <select asp-for="ParentId"
                            asp-items="ViewBag.ParentCategories"
                            class="form-select">
                        <option value="">— قسم رئيسي —</option>
                    </select>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn-primary-admin">
                        حفظ القسم
                    </button>
                    <a href="/Admin/Categories" class="btn btn-outline-secondary">
                        إلغاء
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>